{
  "name": "cooking-hub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"node --env-file-if-exists=.env server/index.mjs\" \"vite --host\"",
    "dev:web": "vite --host",
    "build": "tsc -b && vite build",
    "start": "node server/index.mjs",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "recipes:import": "tsx scripts/import-recipes.ts",
    "deploy": "npm run build && wrangler pages deploy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.0",
    "tsx": "^4.23.15",
    "typescript": "~5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.149.0"
  }
}
