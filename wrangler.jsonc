// Configuration Cloudflare Workers (build Git : `npm run build` puis `npx wrangler deploy`).
{
  "name": "cooking-hub",
  "main": "./worker/index.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Seules les routes d'API réveillent le Worker ; le reste est servi en statique.
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // Workers AI : illustrations des recettes de base sans photo (worker/recipeImages.js).
  "ai": { "binding": "AI" },
  "kv_namespaces": [{ "binding": "PRICES", "id": "ed21be4525594e09b081f6bb1b5b7774" }],
  // Relevé des prix des enseignes portugaises (worker/scraper.js) : une petite étape toutes les 10 minutes.
  "triggers": { "crons": ["*/10 * * * *"] }
}
